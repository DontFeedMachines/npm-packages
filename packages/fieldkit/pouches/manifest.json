{
  "schema": 1,
  "pouches": {
    "dressings": {
      "holds": "themes, skins and templates for a platform",
      "package": "@dontfeedmachines/fieldkit-dressings"
    },
    "flint": {
      "holds": "starters: a whole working skeleton you build on",
      "package": "@dontfeedmachines/fieldkit-flint"
    },
    "sutures": {
      "holds": "addons and plugins for an app or platform",
      "package": "@dontfeedmachines/fieldkit-sutures"
    },
    "splints": {
      "holds": "scripts of any format",
      "package": "@dontfeedmachines/fieldkit-splints"
    },
    "triage-tags": {
      "holds": "not decided yet",
      "package": "@dontfeedmachines/fieldkit-triage-tags"
    },
    "spools": {
      "holds": "font families, each with its license",
      "package": "@dontfeedmachines/fieldkit-spools"
    }
  },
  "parts": [
    {
      "id": "dressings/skins",
      "name": "every DFM site as a skin",
      "format": "DRP",
      "platform": "css",
      "origin": "the token stylesheets of all ten sectors, five stations and two commons sites",
      "license": "Apache-2.0",
      "out": "a styles folder in your project",
      "files": [
        {
          "from": "dressings/dfm-all-css/skins.css",
          "to": "dfm-skins.css"
        }
      ]
    },
    {
      "id": "dressings/skins-sources",
      "name": "the original site stylesheets the skins were read from",
      "format": "DRP",
      "platform": "css",
      "origin": "DFM sector, station and commons site stylesheets, copied 2026-11-07",
      "license": "Apache-2.0",
      "out": "anywhere, for reference",
      "files": [
        {
          "from": "dressings/dfm-all-css",
          "to": "dfm-skin-sources",
          "exclude": [
            "skins.css"
          ]
        }
      ]
    },
