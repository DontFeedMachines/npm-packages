---
// DFM custom components
export interface Props {
  level: 1 | 2 | 3 | 4 | 5;
  label?: string;
}
const { level, label } = Astro.props;
const max = 5;
---
<div class="not-content flex items-center gap-4 my-4 p-3 bg-zinc-800/50 rounded-lg border border-zinc-700">
  <div class="text-sm font-semibold uppercase tracking-wider text-zinc-400">
    {label || "Assembly Difficulty"}
  </div>
  <div class="flex gap-1">
    {Array.from({ length: max }).map((_, i) => (
      <svg 
        class={`w-5 h-5 ${i < level ? 'text-amber-500' : 'text-zinc-600'}`} 
        xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
      >
        <path fill-rule="evenodd" d="M14.615 1.595a.75.75 0 01.359.852L12.982 9.75h7.268a.75.75 0 01.548 1.262l-10.5 11.25a.75.75 0 01-1.272-.71l1.992-7.302H3.75a.75.75 0 01-.548-1.262l10.5-11.25a.75.75 0 01.913-.143z" clip-rule="evenodd" />
      </svg>
    ))}
  </div>
  <div class="text-xs text-zinc-500">
    {level} / 5
  </div>
</div>
