---
// DFM custom components
export interface Props {
  vectors: string[]; 
}
const { vectors } = Astro.props;

const allVectors = [
  { id: 'acoustic', label: 'Acoustic' },
  { id: 'rf', label: 'RF / Wireless' },
  { id: 'visual', label: 'Visual / Optical' },
  { id: 'network', label: 'Network / Digital' }
];
---
<div class="not-content my-6">
  <h4 class="text-sm font-bold uppercase tracking-widest text-zinc-400 mb-3">Mitigated Threat Vectors</h4>
  <div class="flex flex-wrap gap-2">
    {allVectors.map(v => {
      const active = vectors.includes(v.id);
      return (
        <div class={`flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold ${active ? 'bg-emerald-900/30 text-emerald-400 border border-emerald-800' : 'bg-zinc-800/30 text-zinc-600 border border-zinc-800'}`}>
          {active ? (
            <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          ) : (
            <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          )}
          {v.label}
        </div>
      )
    })}
  </div>
</div>
