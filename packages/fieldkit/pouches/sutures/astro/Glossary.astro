---
// DFM custom components
export interface Props {
  term: string;
  definition: string;
}

const { term, definition } = Astro.props;
---
<span class="glossary-term" data-definition={definition}>
  {term}
  <span class="glossary-tooltip">{definition}</span>
</span>

<style>
  .glossary-term {
    position: relative;
    border-bottom: 1px dotted var(--sl-color-text-accent, #60a5fa);
    cursor: help;
    color: var(--sl-color-text-accent, #60a5fa);
    font-weight: 500;
  }

  .glossary-tooltip {
    visibility: hidden;
    opacity: 0;
    width: max-content;
    max-width: 250px;
    background-color: var(--sl-color-black, #111);
    color: var(--sl-color-white, #fff);
    text-align: center;
    border: 1px solid var(--sl-color-gray-5, #444);
    border-radius: 6px;
    padding: 0.75rem;
    position: absolute;
    z-index: 10;
    bottom: 125%;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    font-size: 0.85rem;
    font-weight: normal;
    line-height: 1.4;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.5);
  }

  .glossary-tooltip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    margin-left: -5px;
    border-width: 5px;
    border-style: solid;
    border-color: var(--sl-color-gray-5, #444) transparent transparent transparent;
  }

  .glossary-term:hover .glossary-tooltip,
  .glossary-term:focus-within .glossary-tooltip {
    visibility: visible;
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
</style>
