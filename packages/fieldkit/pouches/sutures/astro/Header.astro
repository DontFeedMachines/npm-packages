---
import SiteTitle from "./SiteTitle.astro";
import { config, getTranslations } from "../../../src/wiki/config.ts";
import ThemeSwitch from "./ThemeSwitch.astro";
import Search from "./Search.astro";
import LanguageSelect from "@astrojs/starlight/components/LanguageSelect.astro";
import { teletextPages, FASTEXT } from "../../../src/wiki/teletext.ts";

// get current locale from URL
const locale = Astro.currentLocale || "en";

const menu = await getTranslations(locale || "en");

const { settings, navigation_button } = config;
const { main }: { main: any[] } = menu;
const pathname = Astro.request.url;

const hasSidebar = Astro.locals.starlightRoute.hasSidebar;

const routeSidebar = Astro.locals.starlightRoute.sidebar;
const pages = teletextPages(routeSidebar);
const holdsCurrent = (item: any): boolean => item?.isCurrent || (Array.isArray(item?.entries) && item.entries.some(holdsCurrent));
const groupIndex = routeSidebar.findIndex(holdsCurrent);
const pageNo = !hasSidebar ? "P100" : groupIndex >= 0 ? `P${200 + groupIndex * 100}` : "P---";
---

<div class="tt-status container" aria-hidden="true">
  <span class="tt-status-page" data-tt-page>{pageNo}</span>
  <span class="tt-status-name">{config.site.status_name}</span>
  <span class="tt-status-clock" data-tt-clock></span>
</div>

<nav class="navbar container">
  <!-- logo -->
  <div class="order-0">
    <SiteTitle />
  </div>
  <!-- navbar toggler -->
  <input id="nav-toggle" type="checkbox" class="hidden" />
  <label
    for="nav-toggle"
    class="order-3 cursor-pointer flex items-center lg:hidden dark:text-white lg:order-1 hamburger-menu"
  >
    <svg id="show-button" class="h-6 fill-current block" viewBox="0 0 20 20">
      <title>Menu Open</title>
      <path d="M0 3h20v2H0V3z m0 6h20v2H0V9z m0 6h20v2H0V0z"></path>
    </svg>
    <svg id="hide-button" class="h-6 fill-current hidden" viewBox="0 0 20 20">
      <title>Menu Close</title>
      <polygon
        points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2"
        transform="rotate(45 10 10)"></polygon>
    </svg>
  </label>
  <!-- /navbar toggler -->
  <ul
    id="nav-menu"
    class="navbar-nav order-3 hidden w-full pb-6 lg:order-1 lg:flex lg:w-auto lg:space-x-2 lg:pb-0 xl:space-x-8"
  >
    {
      main.map((menu) => (
        <>
          {menu.hasChildren ? (
            <li class="nav-item nav-dropdown group relative">
              <span
                class={`nav-link flex! gap-1! items-center justify-center ${
                  menu.children
                    ?.map(({ url }: { url: string }) => url)
                    .includes(pathname) ||
                  menu.children
                    ?.map(({ url }: { url: string }) => `${url}/`)
                    .includes(pathname)
                    ? "active"
                    : ""
                }`}
              >
                {menu.name}
                <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" />
                </svg>
              </span>
              <ul class="nav-dropdown-list hidden group-hover:block lg:invisible lg:absolute lg:block lg:opacity-0 lg:group-hover:visible lg:group-hover:opacity-100">
                {menu.children?.map((child: { url: string; name: string; hasChildren?: boolean; children?: { url: string; name: string }[] }) =>
                  child.hasChildren && child.children?.length ? (
                    <li class="nav-dropdown-item nav-subdropdown">
                      <span class="nav-dropdown-link nav-subdropdown-toggle">
                        {child.url ? <a href={child.url} class="nav-subdropdown-title">{child.name}</a> : child.name}
                        <svg class="nav-subdropdown-arrow h-4 w-4 fill-current" viewBox="0 0 20 20">
                          <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" />
                        </svg>
                      </span>
                      <ul class="nav-dropdown-list nav-subdropdown-list">
                        {child.children.map((sub) => (
                          <li class="nav-dropdown-item">
                            <a
                              href={sub.url}
                              aria-label={sub.name}
                              class={`nav-dropdown-link block ${
                                (pathname === `${sub.url}/` || pathname === sub.url) && "active"
                              }`}
                            >
                              {sub.name}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </li>
                  ) : (
                    <li class="nav-dropdown-item">
                      <a
                        href={child.url}
                        aria-label={child.name}
                        class={`nav-dropdown-link block ${
                          (pathname === `${child.url}/` ||
                            pathname === child.url) &&
                          "active"
                        }`}
                      >
                        {child.name}
                      </a>
                    </li>
                  )
                )}
              </ul>
            </li>
          ) : (
            <li class="nav-item">
              <a
                href={menu.url}
                class={`nav-link block ${
                  (pathname === `${menu.url}/` || pathname === menu.url) &&
                  "active"
                }`}
              >
                {menu.name}
              </a>
            </li>
          )}
        </>
      ))
    }
    {
      navigation_button.enable && (
        <li class="mt-4 inline-block lg:hidden">
          <a
            class="btn btn-outline-primary btn-sm"
            href={navigation_button.link}
          >
            {navigation_button.label}
          </a>
        </li>
      )
    }
  </ul>

  <div
    class="order-1 ml-auto flex items-center md:order-2 lg:ml-0 navbar-actions"
  >
    {
      hasSidebar && settings.search && (
        <div class="search-bar">
          <Search />
        </div>
      )
    }

    {!hasSidebar && <div class="mr-4"><LanguageSelect /></div> }
    {settings.theme_switcher && <ThemeSwitch className="lg:mx-6 mr-10" />}

    {
      navigation_button.enable && (
        <a
          class="btn btn-outline-primary hidden! lg:inline-block!"
          href={navigation_button.link}
        >
          {navigation_button.translations
            ? // @ts-ignore
              navigation_button.translations[locale] || navigation_button.label
            : navigation_button.label}
        </a>
      )
    }
  </div>
</nav>

<nav class="tt-fastext container" aria-label="sections">
  {pages.slice(0, 4).map((p, i) => (
    <a class={`tt-fx tt-fx-${FASTEXT[i]}`} href={p.href}>{p.label}<span class="tt-fx-page">{p.page}</span></a>
  ))}
</nav>

<script type="application/json" id="tt-pages" set:html={JSON.stringify(pages.map((p) => [p.page, p.href]))}></script>

<script>
  const clock = document.querySelector<HTMLElement>("[data-tt-clock]");
  const tick = () => {
    if (!clock) return;
    const d = new Date();
    const day = d.toLocaleDateString("en-GB", { weekday: "short", day: "2-digit", month: "short" }).replace(/,/g, "");
    clock.textContent = `${day} ${d.toTimeString().slice(0, 8)}`;
  };
  tick();
  setInterval(tick, 1000);

  const table = new Map<number, string>([[100, "/"], ...JSON.parse(document.getElementById("tt-pages")?.textContent || "[]")]);
  const pageEl = document.querySelector<HTMLElement>("[data-tt-page]");
  const resting = pageEl?.textContent ?? "";
  let typed = "";
  let reset: number | undefined;
  window.addEventListener("keydown", (e) => {
    const t = e.target as HTMLElement;
    if (e.metaKey || e.ctrlKey || e.altKey || t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
    if (!/^[0-9]$/.test(e.key)) return;
    typed += e.key;
    clearTimeout(reset);
    if (pageEl) pageEl.textContent = `P${typed.padEnd(3, "-")}`;
    if (typed.length < 3) {
      reset = window.setTimeout(() => { typed = ""; if (pageEl) pageEl.textContent = resting; }, 2500);
      return;
    }
    const href = table.get(Number(typed));
    typed = "";
    if (href) location.href = href;
    else if (pageEl) {
      pageEl.textContent = "NO PAGE";
      reset = window.setTimeout(() => { if (pageEl) pageEl.textContent = resting; }, 1500);
    }
  });
</script>

<script>
  // add header bg after scroll
  const nav = document.querySelector(".navbar");
  const sidebar = document.querySelector(".sidebar-nav");

  window.onscroll = function () {
    if (
      document.body.scrollTop > 10 ||
      document.documentElement.scrollTop > 10
    ) {
      nav?.parentElement?.classList.add("navbar-scrolled");
      sidebar?.classList.add("navbar-scrolled");
    } else {
      nav?.parentElement?.classList.remove("navbar-scrolled");
      sidebar?.classList.remove("navbar-scrolled");
    }
  };

  // mobile navigation dropdown toggle
  const dropdownMenuToggler = document.querySelectorAll(
    ".nav-dropdown > .nav-link"
  ) as NodeListOf<HTMLElement>;

  dropdownMenuToggler.forEach((toggler: HTMLElement) => {
    toggler?.addEventListener("click", (e: MouseEvent) => {
      (e?.target as HTMLElement)
        ?.closest(".nav-item")
        ?.classList.toggle("active");
    });
  });

  // nested dropdowns fly out on hover at desktop widths, tap to expand on mobile
  document.querySelectorAll<HTMLElement>(".nav-subdropdown-toggle").forEach((toggler) => {
    toggler.addEventListener("click", (e: MouseEvent) => {
      if ((e.target as HTMLElement).closest("a")) return;
      e.stopPropagation();
      toggler.closest(".nav-subdropdown")?.classList.toggle("active");
    });
  });
</script>
