---
// DFM custom components
export interface Props {
  jurisdiction?: string;
}
const { jurisdiction = "your local jurisdiction" } = Astro.props;
---
<div class="not-content border-l-4 border-red-600 bg-red-900/20 p-4 my-6 rounded-r-md">
  <div class="flex items-center gap-2 text-red-500 font-bold mb-2">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
    LEGAL DISCLAIMER
  </div>
  <p class="text-sm m-0 text-red-200">
    The deployment of this hardware may violate laws in <strong>{jurisdiction}</strong>. 
    This information is provided strictly for educational and defensive auditing purposes. 
    You are solely responsible for compliance with local communications and privacy legislation.
  </p>
</div>
