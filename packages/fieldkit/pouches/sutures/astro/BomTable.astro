---
// DFM custom components
export interface Props {
  items: Array<{
    name: string;
    qty: number;
    cost?: string;
    link?: string;
    notes?: string;
  }>;
}
const { items } = Astro.props;
---
<div class="not-content overflow-x-auto my-6 border border-zinc-800 rounded-lg">
  <table class="w-full text-left border-collapse text-sm">
    <thead>
      <tr class="bg-zinc-900/50 border-b border-zinc-800">
        <th class="p-3 font-semibold text-zinc-300">Component</th>
        <th class="p-3 font-semibold text-zinc-300 w-16 text-center">Qty</th>
        <th class="p-3 font-semibold text-zinc-300 w-24">Est. Cost</th>
        <th class="p-3 font-semibold text-zinc-300">Notes</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-zinc-800/50 bg-zinc-900/20">
      {items.map(item => (
        <tr class="hover:bg-zinc-800/30 transition-colors">
          <td class="p-3">
            {item.link ? (
              <a href={item.link} target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:text-blue-300 hover:underline flex items-center gap-1">
                {item.name}
                <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              </a>
            ) : (
              <span class="text-zinc-200">{item.name}</span>
            )}
          </td>
          <td class="p-3 text-center text-zinc-400">{item.qty}</td>
          <td class="p-3 text-zinc-400 font-mono text-xs">{item.cost || '-'}</td>
          <td class="p-3 text-zinc-500 text-xs">{item.notes || '-'}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
